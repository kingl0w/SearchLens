#typesense configuration
#admin key — used for indexing only, never expose to client
TYPESENSE_HOST=your-cluster.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_API_KEY=your-admin-api-key

#public keys — safe for client side search
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=your-search-only-key
NEXT_PUBLIC_TYPESENSE_HOST=your-cluster.a1.typesense.net
NEXT_PUBLIC_TYPESENSE_PORT=443
NEXT_PUBLIC_TYPESENSE_PROTOCOL=https
